DATABASE_URL=postgresql+psycopg://verity:verity@localhost:5432/verity
HF_HOME=./.cache/huggingface

# Where uploaded documents are stored by the API.
VERITY_UPLOAD_DIR=./uploads

# --- the outside-agent surface ----------------------------------------------
# The MCP server (`uv run verity-mcp`) is a client of the API, not a copy of
# it, so it needs to know where the API is. It does not start one.
VERITY_API_URL=http://127.0.0.1:8000
# How long the MCP tool waits on one audit. A cold extraction checkpoint is
# slow; finite so an API that is down surfaces as an error rather than a hang.
# VERITY_MCP_TIMEOUT=300

# The base URL a ChatGPT Action calls, written into the exported OpenAPI
# schema by `scripts/export_openapi.py`. Has to be reachable from ChatGPT,
# which localhost is not.
# VERITY_PUBLIC_URL=https://verity.example.com

# Optional: the mirror used for the SROIE corpus, which supplies the supplier
# and date labels CORD does not have. Only needed to run that evaluation.
VERITY_SROIE_DATASET=darentang/sroie

# --- the citation check (optional) ------------------------------------------
# The one place a language model touches an audit: after the controls have run,
# Claude is asked whether the policy each finding quoted actually supports it.
# It cannot change a verdict. Leave the key unset and the check reports itself
# as skipped -- which is not the same as passed, and is never recorded as one.
ANTHROPIC_API_KEY=

# Override the model the check runs on. Defaults to claude-opus-5.
# VERITY_LLM_MODEL=claude-opus-5

# --- tracing to Langfuse (optional) -----------------------------------------
# Verity always keeps its own trace, on the result and in the trace_steps
# table. These only add a copy in a tool built for looking across runs. Needs
# `uv sync --extra obs`; if the backend is down the audit is unaffected.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
